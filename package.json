{
  "name": "opencode-ci-watch",
  "version": "0.1.0",
  "description": "OpenCode plugin: branch, commit and run scoped GitHub Actions watching without polling",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:watch": "node --test --watch test/*.test.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "github-actions",
    "ci"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "@opencode/theme": "^2.3.2",
    "@opentui/core": "^0.9.6",
    "@opentui/solid": "^0.9.6",
    "@types/node": "^26.6.6",
    "solid-js": "^1.9.20",
    "typescript": "^7.0.2"
  }
}
